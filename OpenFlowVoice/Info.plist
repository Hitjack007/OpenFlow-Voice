<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>OpenFlow Voice</string>
	<key>CFBundleDisplayName</key>
	<string>OpenFlow Voice</string>
	<!-- Deliberately space-free and distinct from any other dictation app, so that
	     `pkill`/`killall` on this app can never match a differently-named binary. -->
	<key>CFBundleExecutable</key>
	<string>OpenFlowVoice</string>
	<key>CFBundleIdentifier</key>
	<string>com.Hitjack007.OpenFlow-Voice</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Lets the dashboard's Clear button call back into the app. A file:// page can't
	     write files or talk to a process, but it can follow a custom-scheme link. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.Hitjack007.OpenFlow-Voice</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>openflowvoice</string>
			</array>
		</dict>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSAccessibilityUsageDescription</key>
	<string>OpenFlow Voice monitors your push-to-talk key and types transcribed text into other apps.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>OpenFlow Voice listens while you hold the push-to-talk key so it can turn your speech into text.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>OpenFlow Voice transcribes your speech on-device to insert text where you're typing.</string>
	<key>SUFeedURL</key>
	<string>https://hitjack007.github.io/OpenFlow-Voice/appcast.xml</string>
	<!-- Run generate_keys (Sparkle tool in DerivedData) and paste the public key below -->
	<key>SUPublicEDKey</key>
	<string>6xY6JsEkEG2HPn7hPwS457+wIYZ96Yc7NLR88xZsFPg=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUEnableDownloaderService</key>
	<true/>
	<key>SUEnableInstallerLauncherService</key>
	<true/>
</dict>
</plist>
