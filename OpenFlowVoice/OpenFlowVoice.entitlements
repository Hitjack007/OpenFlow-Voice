<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Deliberately NOT sandboxed: a CGEventTap and system-wide AX access are both
	     impossible inside the App Sandbox. Distribution would be Developer ID, not MAS.
	     Explicitly false here so Xcode archiving cannot infer sandbox from project settings. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Sparkle background XPC services: downloader (-spks) and installer launcher (-spki) -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>com.Hitjack007.OpenFlow-Voice-spks</string>
		<string>com.Hitjack007.OpenFlow-Voice-spki</string>
	</array>
</dict>
</plist>
