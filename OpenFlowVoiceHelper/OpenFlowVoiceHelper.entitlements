<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The helper is NOT sandboxed: CGEventTap and system-wide AX access require it. -->
	<!-- TCC trust for Accessibility is granted to this helper bundle ID, not the main app. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
